# Copy this file to .env and fill in your actual keys
# NEVER commit .env to git — it will be in .gitignore

# Get from https://t.me/BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Get from https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Force a specific Gemini model (leave blank to auto-detect)
GEMINI_MODEL=
